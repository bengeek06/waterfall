{
  "name": "waterfall-root",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api-client:generate": "npm --workspace @waterfall/api-client run generate",
    "api-client:build": "npm --workspace @waterfall/api-client run build",
    "frontend:dev": "npm --workspace frontend run dev",
    "frontend:build": "npm run api-client:build && npm --workspace frontend run build",
    "frontend:lint": "npm --workspace frontend run lint",
    "frontend:test": "npm --workspace frontend run test"
  }
}
