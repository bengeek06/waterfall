{
  "name": "@waterfall/api-client",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "openapi-typescript ../../openapi/waterfall_v1.yaml -o src/generated/api-types.ts",
    "build": "npm run generate && tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "openapi-typescript": "^7.10.0",
    "typescript": "^5.9.2"
  }
}
