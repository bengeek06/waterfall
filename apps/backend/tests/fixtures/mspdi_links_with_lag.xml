<?xml version="1.0" encoding="UTF-8"?>
<!--
  Couverture : liens de prédécesseur des quatre types MSPDI (0=FF, 1=FS, 2=SS,
  3=SF), avec décalages positif et négatif, et une tâche portant deux
  prédécesseurs.

  Pourquoi cette fixture : le type et le décalage (LinkLag, en dixièmes de
  minute, avec son LagFormat) sont recopiés tels quels d'un bout à l'autre de la
  chaîne import -> révision -> export. Un fichier ne contenant que des FS à
  décalage nul laisserait passer une perte de type ou de lag sans que rien ne
  rougisse. Les liens vont tous vers l'amont du fichier : le graphe reste
  acyclique, ce que l'import exige (INV-18).

  Données entièrement inventées : aucun planning client n'entre dans le dépôt.
-->
<Project xmlns="http://schemas.microsoft.com/project/2007">
  <SaveVersion>16</SaveVersion>
  <GUID>FIXTURE-MSPDI-LINKS-0001</GUID>
  <Name>mspdi_links_with_lag.xml</Name>
  <ScheduleFromStart>1</ScheduleFromStart>
  <StartDate>2026-03-02T08:00:00</StartDate>
  <FinishDate>2026-09-30T17:00:00</FinishDate>
  <MinutesPerDay>480</MinutesPerDay>
  <MinutesPerWeek>2400</MinutesPerWeek>
  <DaysPerMonth>20</DaysPerMonth>
  <CurrencyCode>EUR</CurrencyCode>
  <Tasks>
    <Task>
      <UID>1</UID>
      <ID>1</ID>
      <Name>Lot A — Approvisionnement</Name>
      <Type>1</Type>
      <OutlineNumber>1</OutlineNumber>
      <OutlineLevel>1</OutlineLevel>
      <Summary>1</Summary>
      <Milestone>0</Milestone>
    </Task>
    <Task>
      <UID>2</UID>
      <ID>2</ID>
      <Name>Étude préliminaire</Name>
      <Type>0</Type>
      <OutlineNumber>1.1</OutlineNumber>
      <OutlineLevel>2</OutlineLevel>
      <Duration>PT2400M</Duration>
      <DurationFormat>7</DurationFormat>
      <Summary>0</Summary>
      <Milestone>0</Milestone>
    </Task>
    <Task>
      <UID>3</UID>
      <ID>3</ID>
      <Name>Rédaction du cahier des charges</Name>
      <Type>0</Type>
      <OutlineNumber>1.2</OutlineNumber>
      <OutlineLevel>2</OutlineLevel>
      <Duration>PT1920M</Duration>
      <DurationFormat>7</DurationFormat>
      <Summary>0</Summary>
      <Milestone>0</Milestone>
      <!-- Fin-à-début sans décalage : le cas nominal. -->
      <PredecessorLink>
        <PredecessorUID>2</PredecessorUID>
        <Type>1</Type>
        <LinkLag>0</LinkLag>
        <LagFormat>7</LagFormat>
      </PredecessorLink>
    </Task>
    <Task>
      <UID>4</UID>
      <ID>4</ID>
      <Name>Consultation des fournisseurs</Name>
      <Type>0</Type>
      <OutlineNumber>1.3</OutlineNumber>
      <OutlineLevel>2</OutlineLevel>
      <Duration>PT4800M</Duration>
      <DurationFormat>7</DurationFormat>
      <Summary>0</Summary>
      <Milestone>0</Milestone>
      <!-- Fin-à-début décalé de +2 jours (9600 dixièmes de minute). -->
      <PredecessorLink>
        <PredecessorUID>3</PredecessorUID>
        <Type>1</Type>
        <LinkLag>9600</LinkLag>
        <LagFormat>7</LagFormat>
      </PredecessorLink>
    </Task>
    <Task>
      <UID>5</UID>
      <ID>5</ID>
      <Name>Lot B — Mise en œuvre</Name>
      <Type>1</Type>
      <OutlineNumber>2</OutlineNumber>
      <OutlineLevel>1</OutlineLevel>
      <Summary>1</Summary>
      <Milestone>0</Milestone>
    </Task>
    <Task>
      <UID>6</UID>
      <ID>6</ID>
      <Name>Montage</Name>
      <Type>0</Type>
      <OutlineNumber>2.1</OutlineNumber>
      <OutlineLevel>2</OutlineLevel>
      <Duration>PT7680M</Duration>
      <DurationFormat>7</DurationFormat>
      <Summary>0</Summary>
      <Milestone>0</Milestone>
      <!-- Deux prédécesseurs sur la même tâche : un fin-à-fin et un début-à-début. -->
      <PredecessorLink>
        <PredecessorUID>4</PredecessorUID>
        <Type>0</Type>
        <LinkLag>0</LinkLag>
        <LagFormat>7</LagFormat>
      </PredecessorLink>
      <PredecessorLink>
        <PredecessorUID>3</PredecessorUID>
        <Type>2</Type>
        <LinkLag>2400</LinkLag>
        <LagFormat>7</LagFormat>
      </PredecessorLink>
    </Task>
    <Task>
      <UID>7</UID>
      <ID>7</ID>
      <Name>Recette usine</Name>
      <Type>0</Type>
      <OutlineNumber>2.2</OutlineNumber>
      <OutlineLevel>2</OutlineLevel>
      <Duration>PT1440M</Duration>
      <DurationFormat>7</DurationFormat>
      <Summary>0</Summary>
      <Milestone>0</Milestone>
      <!-- Début-à-fin avec un décalage négatif de 1 jour (-4800). -->
      <PredecessorLink>
        <PredecessorUID>6</PredecessorUID>
        <Type>3</Type>
        <LinkLag>-4800</LinkLag>
        <LagFormat>7</LagFormat>
      </PredecessorLink>
    </Task>
  </Tasks>
</Project>
