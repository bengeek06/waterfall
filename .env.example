APP_NAME=waterfall
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://waterfall:waterfall@localhost:5432/waterfall
# SECRET_KEY=<set locally or via a secret manager>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ALLOW_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_ALLOWED_DEV_ORIGINS=localhost,127.0.0.1
WF_ADMIN_EMAIL=admin@example.com
WF_ADMIN_IS_ACTIVE=true
# WF_ADMIN_PASSWORD=<set locally or via a secret manager>
# PGADMIN_DEFAULT_PASSWORD=<set locally or via a secret manager>
# GRAFANA_ADMIN_PASSWORD=<set locally or via a secret manager>
# Required, unlike the pgAdmin/Grafana secrets above (which only matter for `make
# up-full`): the base compose file declares REDIS_PASSWORD without a default, and
# Compose interpolates the whole file before selecting services, so `make db-up`,
# `make down` and `make logs` also fail until this is set.
# REDIS_PASSWORD=<set locally or via a secret manager>
# Native dev only (Configuration A): point the API at your own Redis. In Docker the
# compose file sets both for you. Keep the password out of the URL -- it is not
# percent-encoded.
# REDIS_URL=redis://localhost:6379/0
# ADMIN_BIND_ADDRESS=127.0.0.1
